# =====================================================
#  MARK'S - Plantilla de configuración de la API
#
#  1. Copia este archivo y renómbralo a:  .env   (en la carpeta backend)
#  2. Llena tus propios datos.
#  3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# =====================================================

# ---------- Base de datos en la nube (Aiven MySQL 8.4) ----------
# Datos en: console.aiven.io > marks-dbase > servicio MySQL > Overview
# La contraseña se pide al equipo por mensaje privado (NUNCA por GitHub).
DB_HOST=mysql-2cbc0f08-marks-dbase.b.aivencloud.com
DB_PORT=15060
DB_USER=avnadmin
DB_PASSWORD=pega_aqui_la_contraseña_de_aiven
DB_NAME=marks_db
# Certificado CA de Aiven, guardado como backend/ca.pem
DB_SSL_CA=ca.pem

# ---------- Alternativa: MySQL local (sin SSL) ----------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=escribe_aqui_tu_contraseña_de_mysql
# DB_NAME=marks_db
# DB_SSL_CA=

# ---------- Sesión (token JWT) ----------
# Genera uno propio con este comando y pega el resultado:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=pega_aqui_el_secreto_generado

# ---------- Correos ----------
# consola = los códigos de verificación se muestran en la terminal de la API
#           (recomendado para desarrollo; no necesitas Gmail)
# gmail   = envía correos reales (requiere MAIL_USUARIO y MAIL_PASSWORD)
MAIL_MODO=consola
MAIL_USUARIO=
MAIL_PASSWORD=
MAIL_PUERTO=465